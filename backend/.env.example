# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://money:money@localhost:5432/money
# Supabase: use your dashboard's direct or session-pooler URL, change the
# scheme to postgresql+psycopg://, and append ?sslmode=require.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase Auth: project URL and publishable key (legacy anon key also works).
# No JWT secret or service-role key is needed by this backend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Source text is returned for immediate review but not stored by default.
RETAIN_SOURCE_TEXT=false

# Server-side AI credentials. Never expose these as NEXT_PUBLIC variables.
# Gemini handles text extraction and Ask My Money query planning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Inference Providers handle receipt vision and speech recognition.
# The token needs Inference Providers permission.
HF_TOKEN=
HF_INFERENCE_BASE_URL=https://router.huggingface.co
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HF_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
AI_TIMEOUT_SECONDS=45
MAX_UPLOAD_MB=10
