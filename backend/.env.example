# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://money:money@localhost:5432/money
# Supabase: use your dashboard's direct or session-pooler URL, change the
# scheme to postgresql+psycopg://, and append ?sslmode=require.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase Auth: project URL and publishable key (legacy anon key also works).
# No JWT secret or service-role key is needed by this backend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Source text is returned for immediate review but not stored by default.
RETAIN_SOURCE_TEXT=false

# Optional: manual entry, recognized M-Pesa messages, and common questions
# work without a key. Receipt/audio and free-form extraction need this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_TIMEOUT_SECONDS=45
MAX_UPLOAD_MB=10
